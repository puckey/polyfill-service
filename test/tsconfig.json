{
    "compilerOptions": {
        "target": "es2023",
        "lib": ["es2023"],
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "strict": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "skipLibCheck": true,
        "types": ["node", "vitest/globals"]
    },
    "include": ["integration/**/*.ts", "unit/**/*.ts", "vitest.config.ts", "vitest.unit.config.ts"]
}
